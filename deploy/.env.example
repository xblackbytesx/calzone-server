DOMAIN=privacy.box
SUBDOMAIN=calzone
CERT_RESOLVER=transip-dns

DOCKER_ROOT=/media/storage/docker

# Image tag: a release (0.5.0), a series (0.5) or latest.
CALZONE_VERSION=latest

# POSTGRES
POSTGRES_DB=calzone
POSTGRES_USER=calzone
POSTGRES_PASSWORD=<INSERT_RANDOM_STRING>

# SERVER
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@calzone-server-db:5432/${POSTGRES_DB}
CALZONE_BIND=0.0.0.0:8080
RUST_LOG=info
# The address clients use; sign-in QR codes and feed links point here.
CALZONE_PUBLIC_URL=https://calzone.privacy.box
# The CalDAV/CardDAV door for other apps (Thunderbird, DAVx5): on or off.
CALZONE_DAV=on
# Encrypts two-factor secrets at rest. Required. Make one with
# `head -c 32 /dev/urandom | base64` and keep it with your backups: without
# it everyone has to set two-factor up again.
CALZONE_SECRET_KEY=<INSERT_32_BYTES_BASE64>
# Who must use two-factor sign-in: admins (default), everyone or optional.
# Public-facing: everyone is the safer choice.
CALZONE_TWO_FACTOR=everyone
# The time zone for people who have not set their own yet (the calendar
# sends the browser's on first use). IANA name.
CALZONE_DEFAULT_TIMEZONE=Europe/Amsterdam
# Calendar subscriptions fetch outside .ics addresses only. On allows
# private, loopback and link-local addresses too (a feed on your own LAN).
CALZONE_FEEDS_ALLOW_PRIVATE=off
# UnifiedPush servers the CalZone app's phones may receive pushes on, by
# host name (ntfy.privacy.box). Empty: push is off and phones sync on
# Android's own schedule.
CALZONE_PUSH_HOSTS=
# Web login cookie is Secure (https only). Set off only for plain-http LAN use.
CALZONE_COOKIE_SECURE=on
# Behind Traefik: the client address for login throttling comes from
# X-Forwarded-For. Leave off when nothing sits in front of CalZone.
CALZONE_BEHIND_PROXY=on
