# For the LOCAL smoke-test stack (make up). Deployments use deploy/.env.example.
POSTGRES_PASSWORD=change-me
PORT=8080
# The address your devices use; sign-in QR codes and feed links point here.
# CALZONE_PUBLIC_URL=http://192.168.1.10:8080
# The CalDAV/CardDAV door for other apps (Thunderbird, DAVx5): on or off.
# CALZONE_DAV=on
# Encrypts two-factor secrets: head -c 32 /dev/urandom | base64
CALZONE_SECRET_KEY=
# Who must use two-factor sign-in: admins, everyone or optional.
# CALZONE_TWO_FACTOR=admins
# Postgres data. Relative paths resolve from docker/, so prefer absolute paths.
# CALZONE_DB_DIR=/absolute/path/calzone-server/postgres
